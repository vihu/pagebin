# Copy to .env. Both `cargo run` and `docker compose up` read it.
# Real environment variables win over this file. No quotes, no inline comments.

# Required. Any text without newlines.
PAGEBIN_ADMIN_PASSWORD=change-me

# Hostnames, no scheme or port. Browsers resolve *.localhost to this machine.
PAGEBIN_ADMIN_HOST=localhost
PAGEBIN_VIEW_HOST=view.localhost

# The port pagebin listens on, Compose publishes on 127.0.0.1, and share links use.
# Production: PAGEBIN_PUBLIC_URL=https://view.example.com behind a TLS proxy.
PAGEBIN_PORT=5050
PAGEBIN_PUBLIC_URL=http://view.localhost:5050

# Optional.
# 64 hex characters. Unset: generated once into the data directory.
#PAGEBIN_SECRET=
# Enables /api/sites. Same rules as the password.
#PAGEBIN_API_TOKEN=
# Whole MiB, default 50.
#PAGEBIN_MAX_UPLOAD_MB=50
# true only when every request passes through a proxy that sets X-Forwarded-For.
#PAGEBIN_TRUST_PROXY=false
# Storage. Default: ./data natively, the /data volume in the container. Leave unset.
#PAGEBIN_DATA_DIR=data
# Tracing filter, default pagebin=info,tower_http=info.
#RUST_LOG=pagebin=debug
